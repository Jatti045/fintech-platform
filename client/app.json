{
  "expo": {
    "name": "Fundleaf",
    "slug": "budgee-app",
    "version": "4.0.0",
    "description": "Open-source personal finance and budgeting application",
    "orientation": "portrait",
    "privacy": "public",
    "icon": "./assets/fundleaf-brand-assets/app-icon.png",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": [
              "plaidlink"
            ]
          }
        ]
      },
      "bundleIdentifier": "com.budgee.finance",
      "icon": {
        "light": "./assets/fundleaf-brand-assets/app-icon-light.png",
        "dark": "./assets/fundleaf-brand-assets/app-icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fundleaf-brand-assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/fundleaf-brand-assets/adaptive-icon-background.png",
        "backgroundColor": "#0C8057",
        "monochromeImage": "./assets/fundleaf-brand-assets/adaptive-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.budgee.finance",
      "versionCode": 70,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO"
      ],
      "icon": "./assets/fundleaf-brand-assets/app-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/fundleaf-brand-assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/fundleaf-brand-assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF8",
          "dark": {
            "image": "./assets/fundleaf-brand-assets/splash-mark.png",
            "backgroundColor": "#071D17"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/fundleaf-brand-assets/adaptive-icon-monochrome.png",
          "color": "#0C8057",
          "defaultChannel": "purchase-reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67e785e9-2163-4914-b853-1416a5375df6"
      }
    }
  }
}
